#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-all}"

usage() {
  cat <<'EOF'
usage: ./dev/check [all|guardrails|rust|cli|web|ops|smoke]

  all         run every non-browser check group (default)
  guardrails  check source size, crate boundaries, and replicated toolchain pins
  rust        format, test, and lint the main Rust workspace
  cli         format, test, lint, and release-build the standalone CLI workspace
  web         test, check, and build the web application
  ops         test deployment orchestration and benchmark scripts
  smoke       run the browser smoke suite against an already running local stack
EOF
}

read_root_env_value() {
  local key="$1"
  [[ -f .env.local ]] || return 0
  awk -F= -v key="$key" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    $1 == key {
      value = substr($0, index($0, "=") + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
          (substr(value, 1, 1) == "'"'"'" && substr(value, length(value), 1) == "'"'"'")) {
        value = substr(value, 2, length(value) - 2)
      }
      print value
      exit
    }
  ' .env.local
}

guardrails() { ./dev/checks/policy; }
rust() { ./dev/checks/backend with-api; }
cli() { ./dev/checks/cli; }
web() { ./dev/checks/web; }
ops() { ./dev/checks/ops; }

smoke() {
  local smoke_repo="${SCOPE_SMOKE_REPO:-}"
  if [[ -z "$smoke_repo" ]]; then
    local handle
    handle="$(read_root_env_value "SCOPE_DEV_USER_HANDLE")"
    if [[ -n "$handle" ]]; then
      smoke_repo="$handle/public-demo"
    fi
  fi
  (
    if [[ -n "$smoke_repo" ]]; then
      SCOPE_SMOKE_REPO="$smoke_repo" ./dev/checks/integration web
    else
      ./dev/checks/integration web
    fi
  )
}

cd "$ROOT"

case "$COMMAND" in
  all)
    guardrails
    rust
    cli
    web
    ops
    ;;
  guardrails) guardrails ;;
  rust) rust ;;
  cli) cli ;;
  web) web ;;
  ops) ops ;;
  smoke) smoke ;;
  help|-h|--help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
