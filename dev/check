#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-all}"

usage() {
  cat <<'EOF'
usage: ./dev/check [all|guardrails|rust|cli|web|ops|smoke]

  all         run every non-browser check group (default)
  guardrails  check source size, crate boundaries, and replicated toolchain pins
  rust        format, test, and lint the main Rust workspace
  cli         format, test, lint, and release-build the standalone CLI workspace
  web         test, check, and build the web application
  ops         test deployment orchestration and benchmark scripts
  smoke       run the browser smoke suite against an already running local stack
EOF
}

read_root_env_value() {
  local key="$1"
  [[ -f .env.local ]] || return 0
  awk -F= -v key="$key" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    $1 == key {
      value = substr($0, index($0, "=") + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
          (substr(value, 1, 1) == "'"'"'" && substr(value, length(value), 1) == "'"'"'")) {
        value = substr(value, 2, length(value) - 2)
      }
      print value
      exit
    }
  ' .env.local
}

guardrails() {
  node --test .github/scripts/check-source-size.test.mjs
  node .github/scripts/check-source-size.mjs
  node --test .github/scripts/check-rust-boundaries.test.mjs
  node .github/scripts/check-rust-boundaries.mjs
  node .github/scripts/check-rust-toolchain-sync.mjs
  node --test .github/scripts/check-rust-toolchain-sync.test.mjs
}

rust() {
  cargo fmt --all --check
  cargo test --workspace --features api/test-support --locked
  cargo test -p api --features local-dev --locked dev::
  cargo clippy --workspace --features api/test-support --all-targets --locked -- -D warnings
}

cli() {
  cargo fmt --manifest-path cli/Cargo.toml -- --check
  cargo test --manifest-path cli/Cargo.toml --locked
  cargo clippy --manifest-path cli/Cargo.toml --all-targets --locked -- -D warnings
  cargo build --manifest-path cli/Cargo.toml --release --locked
}

web() {
  (
    cd web
    pnpm test
    pnpm check
    pnpm build
  )
}

ops() {
  node --test .github/scripts/production-deployment-progress.test.mjs
  node --test .github/scripts/plan-production-deployment.test.mjs
  node --test .github/scripts/verify-staging-target.test.mjs
  node --test .github/scripts/stop-staging-writers.test.mjs
  bash .github/scripts/test-deploy-backend-railway.sh
  bash .github/scripts/test-staging-git-smoke.sh
  node --test bench/*.test.mjs
}

smoke() {
  local smoke_repo="${SCOPE_SMOKE_REPO:-}"
  if [[ -z "$smoke_repo" ]]; then
    local handle
    handle="$(read_root_env_value "SCOPE_DEV_USER_HANDLE")"
    if [[ -n "$handle" ]]; then
      smoke_repo="$handle/public-demo"
    fi
  fi
  (
    cd web
    if [[ -n "$smoke_repo" ]]; then
      SCOPE_SMOKE_REPO="$smoke_repo" pnpm test:smoke
    else
      pnpm test:smoke
    fi
  )
}

cd "$ROOT"

case "$COMMAND" in
  all)
    guardrails
    rust
    cli
    web
    ops
    ;;
  guardrails) guardrails ;;
  rust) rust ;;
  cli) cli ;;
  web) web ;;
  ops) ops ;;
  smoke) smoke ;;
  help|-h|--help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
