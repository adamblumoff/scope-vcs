#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

case "${1:-}" in
  web) cd web; pnpm test:smoke ;;
  cli) cargo test --manifest-path cli/Cargo.toml --test contribution_flow --locked -- --nocapture ;;
  *) echo "usage: integration web|cli (against an already running stack)" >&2; exit 2 ;;
esac
