#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

cargo fmt --all --check
cargo test --workspace --features api/test-support --locked
cargo test -p api --features local-dev --locked dev::
cargo clippy --workspace --features api/test-support --all-targets --locked -- -D warnings
node web/scripts/check-api-contract.mjs
