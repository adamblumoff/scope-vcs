{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "/api/**",
      "/runner-runtime/**",
      "/crates/**",
      "/Cargo.toml",
      "/Cargo.lock",
      "/rust-toolchain.toml"
    ]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "multiRegionConfig": {
      "us-east4-eqdc4a": {
        "numReplicas": 1
      }
    }
  }
}
