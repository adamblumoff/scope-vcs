# Required matching Clerk development keys for `./dev/scope-dev`.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional hostname for remote development access, such as a Tailscale DNS name.
SCOPE_WEB_ALLOWED_HOST=

# Optional. The project token is public and safe to expose in the browser.
# Leave it unset to disable browser analytics.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional server-side Pagent reporting. Use the values generated in
# `.pagent/cloud.env`; leave PAGENT_ENABLED unset to disable it.
PAGENT_ENABLED=
PAGENT_ENV=
PAGENT_ENDPOINT_URL=
PAGENT_SOURCE_TOKEN=
PAGENT_ENCRYPTION_KEY_ID=
PAGENT_ENCRYPTION_KEY=
